# All variables are read by app/settings.py; copy this file to .env locally.
# SQLAlchemy URL; SQLite is the local default, PostgreSQL is supported.
DATABASE_URL=sqlite:///./sus.db

# Redis connection for failed-attempt counters.
REDIS_URL=redis://localhost:6379/0

# Set a private key in .env to enable authentication for login evaluation.
API_KEY=

# Optional GeoIP and model paths; integrations are planned for later phases.
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
MODEL_PATH=artifacts/model.joblib

# Non-enforcing mode; decision enforcement is planned for Phase 4.
SHADOW_MODE=true
