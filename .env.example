# All variables are read by app/settings.py; copy this file to .env locally.
# SQLAlchemy URL; SQLite is the local default, PostgreSQL is supported.
DATABASE_URL=sqlite:///./sus.db

# Redis connection for failed-attempt counters.
REDIS_URL=redis://localhost:6379/0

# Optional shared API-key rate limit; requires Redis when enabled.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Set a private key in .env to enable authentication for login evaluation.
API_KEY=

# MaxMind GeoLite2 City database path; enable API lookups below when available.
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_ENABLED=false

# High-risk IPv4/IPv6 addresses and CIDRs as a JSON list.
HIGH_RISK_IP_NETWORKS=[]

# Base path for versioned model artifacts and the latest-model manifest.
MODEL_PATH=artifacts/model.joblib
# Enable model scoring in API evaluation after a model has been trained.
ML_ENABLED=false

# Maximum score for allow and challenge decisions.
ALLOW_MAX_SCORE=39
CHALLENGE_MAX_SCORE=78

# Downstream enforcement marker; this API itself always returns recommendations.
SHADOW_MODE=true
