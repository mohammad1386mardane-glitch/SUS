# Local development database
DATABASE_URL=sqlite:///./sus.db

# Redis is planned for velocity counters.
REDIS_URL=redis://localhost:6379/0

# Set this in your private .env file; do not commit a real key.
API_KEY=

# Optional data and model paths; these files are not included.
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
MODEL_PATH=artifacts/model.joblib

# Start in non-enforcing mode while measuring false positives.
SHADOW_MODE=true
